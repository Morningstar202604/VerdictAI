# Runtime QA evidence (regenerable via make_pdf.py)
backend/dogfood-output/test-data/*.pdf

# Secrets backup (never commit)
backend/.env.backup-*
backend/.env.*.bak

# Runtime AI-extracted structures & user knowledge bases
backend/data/agent_config.json
backend/data/knowledge_base.json
backend/data/presets.json

# Runtime-generated case charts (regenerated per case; generate_case.py
# redraws the template charts on every call, so tracked copies go stale)
backend/data/cases/assets/

# Mimosa scanner runtime state (session-local, never commit)
backend/.mimosa/

# Backup archives (produced by tools/backup.py)
backend/data/backups/
backend/data/logs/
