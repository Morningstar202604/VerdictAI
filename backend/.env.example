# LLM Provider: mock (offline demo) | openai | openai_compatible | ollama
LLM_PROVIDER=mock

# API Key (required for non-mock providers)
LLM_API_KEY=
LLM_BASE_URL=

# Models
LLM_MODEL=gpt-4o-mini
INTAKE_MODEL=gpt-4o-mini

# Ollama (local models)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:14b

# Debate settings
MAX_ROUNDS=3
HUMAN_IN_THE_LOOP=false
LLM_TEMPERATURE=0.3

# Server
HOST=0.0.0.0
PORT=8787
