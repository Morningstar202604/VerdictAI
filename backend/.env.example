# ===== LLM 配置 =====
# Provider: mock (离线演示) | openai | openai_compatible | ollama
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini
# 卷宗预处理专用模型（JSON 输出稳定的模型），留空则用主模型
INTAKE_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.3

# Ollama 本地模型
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:14b

# ===== 辩论配置 =====
MAX_ROUNDS=3
# 审判长模式: ai=AI自动裁决 | human=人类法官最终裁决
JUDGE_MODE=ai
# 人类审判长落槌等待超时（秒），0=不限时
HITL_TIMEOUT=300
HUMAN_IN_THE_LOOP=false

# ===== Agent 工程 =====
# 跨轮记忆窗口（注入前几轮摘要）
MEMORY_ROUNDS=2
# 单次 LLM 调用最大上下文字符数（0=不限制）
CONTEXT_CHAR_LIMIT=12000
# 同轮专家并行上限（API 限流保护）
MAX_CONCURRENCY=4
# 单次 LLM 调用超时（秒），0=不限制
LLM_TIMEOUT=180

# ===== 工具开关 =====
# 联网搜索（Bing 国内源）
WEB_SEARCH_ENABLED=true
# Python 代码沙箱（专家可执行计算/图表）
CODE_SANDBOX_ENABLED=true
CODE_SANDBOX_PYTHON=python3

# ===== 服务配置 =====
HOST=0.0.0.0
PORT=8787
# 访问口令：为空=开放访问；设置后所有页面/接口/WS 需登录
ACCESS_PASSWORD=
# CORS 允许来源（逗号分隔）
CORS_ORIGINS=http://localhost:8787,http://127.0.0.1:8787,http://localhost:5173,http://127.0.0.1:5173
# 请求体最大字节（默认 25MB，防止超大 PDF 撑爆内存）
MAX_REQUEST_SIZE=26214400

# ===== 数据目录 =====
DATA_DIR=./data
