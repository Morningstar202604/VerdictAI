# ===== LLM 配置 =====
# Provider: openai_compatible（默认，直连自带本地推理引擎，真实分析）
#         | mock (离线占位演示) | openai | ollama
# 本地引擎由 tools/start_all.py 一键拉起（端口 9100），无需 API Key。
# 换云端模型：把 LLM_BASE_URL 指向云端地址并填 LLM_API_KEY。
LLM_PROVIDER=openai_compatible
LLM_API_KEY=
LLM_BASE_URL=http://127.0.0.1:9100/v1
LLM_MODEL=verdict-local
# 卷宗预处理专用模型（本地引擎按此名走"分案法官"确定性抽取）
INTAKE_MODEL=verdict-local-intake
LLM_TEMPERATURE=0.3

# Ollama 本地模型
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:14b

# ===== 辩论配置 =====
MAX_ROUNDS=3
# 审判长模式: ai=AI自动裁决 | human=人类法官最终裁决
JUDGE_MODE=ai
# 人类审判长落槌等待超时（秒），0=不限时
HITL_TIMEOUT=300
HUMAN_IN_THE_LOOP=false

# ===== Agent 工程 =====
# 跨轮记忆窗口（注入前几轮摘要）
MEMORY_ROUNDS=2
# 单次 LLM 调用最大上下文字符数（0=不限制）
CONTEXT_CHAR_LIMIT=12000
# 同轮专家并行上限（API 限流保护）
MAX_CONCURRENCY=4
# 单次 LLM 调用超时（秒），0=不限制
LLM_TIMEOUT=180
# 单次 LLM 调用最大输出 token 数（思维链类模型 reasoning_content 占用 token，
# 设置过小会导致 JSON/长分析被截断；0=交给平台默认）。建议 4000~8000
LLM_MAX_TOKENS=8000
# LLM 响应 LRU 缓存条数：同一 prompt 命中直接回放（降本提速）；0=关闭
LLM_CACHE_SIZE=0

# ===== 限流 / 成本核算 =====
# API 限流（按客户端 IP 窗口内最大请求数；0=关闭）。大厂 Agent 平台标配——
# 防脚本滥用/打爆模型额度；登录页与健康检查豁免
RATE_LIMIT_MAX=0
# 限流窗口（秒）
RATE_LIMIT_WINDOW=60
# 成本核算：每千 token 单价（美元），0=不核算。用量面板据此换算成本。
# 示例（agnes-flash 等低价模型可参考 0.15 / 0.60；gpt-4o 约 2.5 / 10）
LLM_COST_PER_1K_IN=0
LLM_COST_PER_1K_OUT=0
# 字符→token 估算系数（中文约 1字≈1.5 token；仅用于成本估算，非精确计量）
LLM_CHARS_PER_TOKEN=1.5

# ===== 工具开关 =====
# 联网搜索（Bing 国内源）
WEB_SEARCH_ENABLED=true
# Python 代码沙箱（专家可执行计算/图表）
CODE_SANDBOX_ENABLED=true
CODE_SANDBOX_PYTHON=python3
# 沙箱后端: auto=有 Docker 用容器（默认断网+512MB/1核/128进程限额），
#         否则本机子进程隔离模式（60s 超时、剥离敏感环境变量）
#         | subprocess=强制本机 | docker=强制容器（不可用时报错提示）
CODE_SANDBOX_BACKEND=auto
# 容器沙箱镜像（需先 docker pull）
CODE_SANDBOX_DOCKER_IMAGE=python:3.12-slim
# 沙箱静态命令黑名单（逗号分隔）：执行前检查，命中即拒绝——
# 兜底 subprocess 模式的联网/进程/破坏性操作；容器模式也已断网
CODE_SANDBOX_DENY_CMDS=socket,urllib,requests,httpx,http.client,curl,wget,subprocess,os.system,os.popen,pty,shutil.rmtree
# 沙箱产物（图表）输出目录
SANDBOX_OUT_DIR=./data/sandbox_out
# MCP 外部工具（P1-5）：也可用环境变量 MCP_SERVERS_JSON 直接给 JSON 数组
# （部署免落盘），或写 data/mcp_servers.json。示例见 backend/app/agents/mcp.py。
# MCP_SERVERS_JSON=[{"name":"files","command":"npx","args":["-y","@modelcontextprotocol/server-filesystem","/tmp"],"roles":["law","forensic"]}]

# ===== 性能与可观测 =====
# 专家发言流式输出: auto=非 mock 供应商启用（端点不支持自动回退）| on | off
STREAM_EXPERTS=auto
# 同轮专家并行: auto=非 mock 供应商并行（真实 LLM 耗时降为 1/4~1/6）| on | off
PARALLEL_EXPERTS=auto
# WebSocket 断线宽限期（秒）：断线后辩论保活等待重连，宽限期内可续看不重跑；0=断开立即取消
WS_DETACH_GRACE=120
# 提示词审计：true 时把每次专家调用的提示词/响应原文落盘 data/audit/（用量面板可汇总）
AUDIT_PROMPTS=false

# ===== 服务配置 =====
HOST=0.0.0.0
PORT=8787
# 访问口令：为空=开放访问；设置后所有页面/接口/WS 需登录
ACCESS_PASSWORD=
# CORS 允许来源（逗号分隔）
CORS_ORIGINS=http://localhost:8787,http://127.0.0.1:8787,http://localhost:5173,http://127.0.0.1:5173
# 请求体最大字节（默认 25MB，防止超大 PDF 撑爆内存）
MAX_REQUEST_SIZE=26214400

# ===== 数据目录 =====
DATA_DIR=./data

# ===== 可选智能能力（缺省自动降级，无需全装） =====
# 扫描件 OCR / 图片文字：需 pip install -r requirements-ai.txt；false 时扫描件仅返回提示
OCR_ENABLED=true
# 联网搜索实现：searxng（默认，自托管 JSON 端点，无 API Key）
#            | bing_html（抓取兜底） | tavily（可选，需 TAVILY_API_KEY）
SEARCH_PROVIDER=searxng
# 你的 SearXNG 实例地址（docker 一条命令：docker run -p 8888:8080 searxng/searxng）
SEARCH_BASE_URL=http://127.0.0.1:8888
SEARCH_TIMEOUT=12
# 知识库语义检索嵌入模型：bge-small-zh（本地，免联网，需 requirements-ai.txt）
#                   | off（关闭语义检索，退回纯关键词）
EMBEDDING_MODEL=bge-small-zh
EMBEDDING_DEVICE=cpu
